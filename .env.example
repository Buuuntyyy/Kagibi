# =============================================================
# Kagibi — Configuration auto-hébergement
# Copiez ce fichier : cp .env.example .env
# Remplissez les valeurs marquées REQUIRED avant de lancer
# docker compose up -d
# =============================================================

# ===== Version =====

# Tag des images ghcr.io/bunnntyyy/kagibi-backend et kagibi-frontend à utiliser.
# "latest" convient pour découvrir Kagibi, mais pour un déploiement réel, épinglez une
# version précise (ex: v2.31.0) et ne la changez que volontairement, lors d'une mise à
# jour maîtrisée — voir la page "Mise à jour" de la documentation self-hosting.
# KAGIBI_VERSION=latest

# ===== REQUIRED — Sécurité =====

# Clé secrète JWT — signe les jetons de session. Un secret faible ou par défaut
# permettrait de forger des jetons pour n'importe quel compte.
# Générez une valeur unique avec : openssl rand -hex 32
JWT_SECRET=

# Clé AES-256 pour le chiffrement des emails au repos.
# ATTENTION : ne jamais changer après la première utilisation (les emails existants
# deviendraient illisibles). Générez avec : openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=

# ===== REQUIRED — Base de données =====

# Mot de passe PostgreSQL. Générez avec : openssl rand -hex 24
# N'est appliqué qu'à la PREMIÈRE initialisation du volume db_data/.
DB_PASSWORD=
# Optionnel — surcharger l'utilisateur / la base (défauts : user / mydb)
# DB_USER=user
# DB_NAME=mydb

# ===== REQUIRED — Redis =====

# Mot de passe Redis (requirepass). Redis porte la file de tâches S3, la révocation
# de tokens et le rate-limiting : un accès non authentifié compromet ces protections.
# Générez avec : openssl rand -hex 24
REDIS_PASSWORD=

# ===== REQUIRED — Stockage S3 =====
# Compatible AWS S3, OVH Object Storage, Scaleway, Cloudflare R2, MinIO…
# Sans objet si vous lancez avec docker-compose.garage.yml (stockage local) —
# voir la section GARAGE ci-dessous, qui remplace ces 5 variables.

S3_ENDPOINT=https://s3.example.com
S3_BUCKET=kagibi
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ===== GARAGE — Stockage local self-hosted (optionnel) =====
# Utilisées uniquement en lançant :
#   docker compose -f docker-compose.yaml -f docker-compose.garage.yml up -d
# Voir docs/self-hosting-storage.md pour le workflow complet.
# S3_ACCESS_KEY/S3_SECRET_KEY sont générées automatiquement par garage-init —
# ne pas les renseigner ci-dessus dans ce mode.

# REQUIRED en mode Garage — adresse par laquelle le NAVIGATEUR joint Garage
# (pas le nom de service Docker interne). IP LAN du NAS ou domaine derrière un
# reverse-proxy TLS. Exemple : http://192.168.1.50:3900
# GARAGE_PUBLIC_ENDPOINT=

# Optionnels — valeurs par défaut cohérentes entre bootstrap.sh et le backend
# GARAGE_S3_PORT=3900
# GARAGE_S3_REGION=garage
# GARAGE_BUCKET=kagibi
# GARAGE_KEY_NAME=kagibi-key
# GARAGE_CAPACITY=10G

# ===== REQUIRED — URLs =====

# URL que le navigateur utilise pour atteindre le backend
# En local :        http://localhost:8080/api/v1
# En production :   https://your-domain.com/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# Origines CORS autorisées — doit correspondre à l'URL du frontend.
# NE JAMAIS mettre "*" : incompatible avec l'envoi de cookies/identifiants.
# En local :        http://localhost
# En production :   https://your-domain.com
ALLOWED_ORIGINS=http://localhost

# ===== Authentification =====
# "local"      — Go backend + PostgreSQL, aucun service externe requis (recommandé)
# "supabase"   — Supabase/GoTrue
# "pocketbase" — PocketBase
AUTH_PROVIDER=local

# ===== Billing =====
# false = stockage illimité, aucune UI billing (recommandé pour l'auto-hébergement)
# true  = active les limites de plan (dev/mock par défaut, Stripe en production)
BILLING_ENABLED=false

# ===== P2P / TURN (optionnel) =====
# Requis uniquement pour le transfert P2P entre appareils derrière NAT strict
# TURN_SERVER_URL=turn:turn.your-domain.com:3478
# TURN_USERNAME=username
# TURN_CREDENTIAL=password

# ===== Google Drive Import (optionnel) =====
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_DESKTOP_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_DESKTOP_CLIENT_SECRET=your-desktop-client-secret

# ===== OneDrive Import (optionnel) =====
# MICROSOFT_OAUTH_CLIENT_ID=your-azure-app-client-id

# ===== Dropbox Import (optionnel) =====
# DROPBOX_APP_KEY=your-dropbox-app-key

# ===== Ports (optionnel) =====
# FRONTEND_PORT=80
# BACKEND_PORT=8080
