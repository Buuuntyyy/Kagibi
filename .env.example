# =============================================================
# Kagibi — Self-hosting configuration
# Copy this file: cp .env.example .env
# Fill in the values marked REQUIRED before running
# docker compose up -d
# =============================================================

# ===== Version =====

# Tag of the ghcr.io/buuuntyyy/kagibi-backend and kagibi-frontend images to use.
# "latest" is fine to try Kagibi out, but for a real deployment, pin a specific
# version (e.g. v2.31.0) and only change it deliberately, as part of a controlled
# upgrade — see the "Upgrading" page of the self-hosting documentation.
# KAGIBI_VERSION=latest

# ===== REQUIRED — Security =====

# JWT secret key — signs session tokens. A weak or default secret would let
# anyone forge tokens for any account.
# Generate a unique value with: openssl rand -hex 32
JWT_SECRET=

# AES-256 key for encrypting emails at rest.
# WARNING: never change this after first use (existing emails would become
# unreadable). Generate with: openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=

# ===== REQUIRED — Database =====

# PostgreSQL password. Generate with: openssl rand -hex 24
# Only applied on the FIRST initialization of the db_data/ volume.
DB_PASSWORD=
# Optional — override the user / database name (defaults: user / mydb)
# DB_USER=user
# DB_NAME=mydb

# ===== REQUIRED — Redis =====

# Redis password (requirepass). Redis carries the S3 task queue, token
# revocation, and rate-limiting: unauthenticated access would defeat these
# protections.
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=

# ===== REQUIRED — S3 storage =====
# Compatible with AWS S3, OVH Object Storage, Scaleway, Cloudflare R2, MinIO…
# Not needed if you run with docker-compose.garage.yml (local storage) —
# see the GARAGE section below, which replaces these 5 variables.

S3_ENDPOINT=https://s3.example.com
S3_BUCKET=kagibi
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ===== GARAGE — Local self-hosted storage (optional) =====
# Only used when running:
#   docker compose -f docker-compose.yaml -f docker-compose.garage.yml up -d
# See docs/self-hosting-storage.md for the full workflow.
# S3_ACCESS_KEY/S3_SECRET_KEY are generated automatically by garage-init —
# do not fill them in above in this mode.

# REQUIRED in Garage mode — the address the BROWSER uses to reach Garage
# (not the internal Docker service name). LAN IP of your NAS, or a domain
# behind a TLS reverse proxy. Example: http://192.168.1.50:3900
# GARAGE_PUBLIC_ENDPOINT=

# Optional — defaults kept consistent between bootstrap.sh and the backend
# GARAGE_S3_PORT=3900
# GARAGE_S3_REGION=garage
# GARAGE_BUCKET=kagibi
# GARAGE_KEY_NAME=kagibi-key
# GARAGE_CAPACITY=10G

# ===== REQUIRED — URLs =====

# URL the browser uses to reach the backend
# Local:       http://localhost:8080/api/v1
# Production:  https://your-domain.com/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# Allowed CORS origins — must match the frontend's URL.
# NEVER set this to "*": incompatible with sending cookies/credentials.
# Local:       http://localhost
# Production:  https://your-domain.com
ALLOWED_ORIGINS=http://localhost

# ===== Authentication =====
# "local"      — Go backend + PostgreSQL, no external service required (recommended)
# "supabase"   — Supabase/GoTrue
# "pocketbase" — PocketBase
AUTH_PROVIDER=local

# ===== Billing =====
# false = unlimited storage, no billing UI (recommended for self-hosting)
# true  = enables plan limits (dev/mock by default, Stripe in production)
BILLING_ENABLED=false

# ===== P2P / TURN (optional) =====
# Only required for P2P transfer between devices behind strict NAT
# TURN_SERVER_URL=turn:turn.your-domain.com:3478
# TURN_USERNAME=username
# TURN_CREDENTIAL=password

# ===== Google Drive Import (optional) =====
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_DESKTOP_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_DESKTOP_CLIENT_SECRET=your-desktop-client-secret

# ===== OneDrive Import (optional) =====
# MICROSOFT_OAUTH_CLIENT_ID=your-azure-app-client-id

# ===== Dropbox Import (optional) =====
# DROPBOX_APP_KEY=your-dropbox-app-key

# ===== Ports (optional) =====
# FRONTEND_PORT=80
# BACKEND_PORT=8080
