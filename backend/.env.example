# =================================
# SaferCloud Backend Environment Variables
# Copy this file to .env and fill in your values
# =================================

# ===== AUTH PROVIDER =====
# "local" (default) — Go backend + PostgreSQL, no external service required
# "supabase" — Supabase/GoTrue
# "pocketbase" — PocketBase
AUTH_PROVIDER=local

# ===== JWT (required when AUTH_PROVIDER=local) =====
JWT_SECRET=change-me-use-a-long-random-string

# ===== EMAIL ENCRYPTION (required — all auth providers) =====
# Server-side AES-256-GCM encryption of email addresses at rest.
# A DB dump without this key cannot reveal any email address.
# Generate with: openssl rand -hex 32
# WARNING: changing this key requires re-encrypting all emails in the DB.
EMAIL_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# ===== DATABASE =====
DATABASE_URL=postgres://user:password@localhost:5432/safercloud?sslmode=disable

# ===== REDIS =====
REDIS_URL=redis://localhost:6379

# ===== SUPABASE AUTH (required when AUTH_PROVIDER=supabase) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
# Admin key for user management (register cleanup, recovery, RGPD deletion)
# SUPABASE_ADMIN_KEY=your-service-role-key

# ===== POCKETBASE AUTH (only when AUTH_PROVIDER=pocketbase) =====
# POCKETBASE_URL=http://localhost:8090
# POCKETBASE_ADMIN_EMAIL=admin@safercloud.local
# POCKETBASE_ADMIN_PASSWORD=your-admin-password
# POCKETBASE_JWT_SECRET=your-32-char-minimum-secret

# ===== S3 STORAGE =====
S3_ENDPOINT=s3.amazonaws.com
S3_BUCKET=safercloud-bucket
S3_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ===== S3 BACKUP (réplication quotidienne à 01h00 Paris → bucket Infrequent Access) =====
# Seul S3_BACKUP_BUCKET est obligatoire — les autres héritent des valeurs S3_* si omis.
# S3_BACKUP_BUCKET=     # defaut : S3_BUCKET + "-backup"
# S3_BACKUP_ENDPOINT=   # défaut : S3_ENDPOINT
# S3_BACKUP_REGION=     # défaut : S3_REGION
# S3_BACKUP_ACCESS_KEY= # défaut : S3_ACCESS_KEY
# S3_BACKUP_SECRET_KEY= # défaut : S3_SECRET_KEY

# ===== CORS =====
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== BILLING =====
# Set to "false" to disable billing completely (self-hosted unlimited mode)
BILLING_ENABLED=true
# BILLING_SERVICE_URL=https://billing.your-domain.com
# BILLING_SERVICE_SECRET=your-64-char-hex-secret

# ===== P2P / TURN Server (Optional) =====
# TURN_SERVER_URL=turn:turn.your-domain.com:3478
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential

# ===== GOOGLE DRIVE IMPORT (Optional) =====
# Allows users to import their Google Drive files directly into Kagibi.
# Files are downloaded and re-encrypted client-side — the backend only receives
# the OAuth client ID (public) to pass to the frontend. No Google token is stored.
#
# Setup:
#   1. Create a project at https://console.cloud.google.com
#   2. Enable "Google Drive API"
#   3. Create OAuth 2.0 credentials (Web application type)
#   4. Add your domain as an Authorized JavaScript origin
#   5. Configure the OAuth consent screen (scope: drive.readonly)
#   6. For production: submit for Google app verification (required for drive.readonly)
#      Until verified, only test users added in the Console can use this feature.
#
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
#
# The desktop app cannot use the Web application client above — Google requires a
# separate "Desktop app" OAuth client for its PKCE loopback flow, and that client
# type requires a client_secret to be exchanged server-side (POST /import/google/desktop-token).
#   7. Create a second OAuth 2.0 credential of type "Desktop app"
#
# GOOGLE_OAUTH_DESKTOP_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_DESKTOP_CLIENT_SECRET=your-desktop-client-secret

# ===== ONEDRIVE IMPORT (Optional) =====
# Allows users to import their OneDrive files directly into Kagibi.
# Same zero-knowledge model as Google Drive import: files are downloaded and
# re-encrypted client-side, the backend only ever hands out the public client ID.
#
# Unlike Google, Microsoft lets a single Azure AD App Registration serve both the
# web frontend and the desktop app, and neither needs a client_secret — both use
# direct PKCE (public client), so the browser/desktop app exchange the auth code
# straight with Microsoft. There is no backend token-exchange endpoint for OneDrive.
#
# Setup:
#   1. Register an app at https://portal.azure.com -> Azure Active Directory -> App registrations
#   2. Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
#      (required so personal/consumer OneDrive accounts can authenticate, not just Microsoft 365 orgs)
#   3. Add platform "Single-page application" with redirect URI(s) pointing at the static
#      callback page (not just the bare origin — the exact path matters):
#      http://localhost:5173/onedrive-callback.html for dev,
#      https://kagibi.cloud/onedrive-callback.html for prod
#   4. Add platform "Mobile and desktop applications" with redirect URI: http://localhost
#      (Microsoft treats this as a wildcard loopback port for native apps — no per-port registration needed)
#   5. API permissions (Microsoft Graph, Delegated): Files.Read.All
#   6. No client secret is created or needed
#
# MICROSOFT_OAUTH_CLIENT_ID=your-azure-app-client-id

# ===== DROPBOX IMPORT (Optional) =====
# Allows users to import their Dropbox files directly into Kagibi.
# Same zero-knowledge model as Google Drive / OneDrive import: files are downloaded and
# re-encrypted client-side, the backend only ever hands out the public app key.
#
# Like OneDrive, Dropbox supports direct PKCE (public client, no client_secret) — the
# browser/desktop app exchange the auth code straight with Dropbox. There is no backend
# token-exchange endpoint for Dropbox.
#
# IMPORTANT: unlike Microsoft (which accepts any port on "http://localhost"), Dropbox
# requires an EXACT redirect_uri match registered in the App Console — no wildcard port.
# The desktop app therefore binds its local OAuth callback server to a FIXED port
# (58273) instead of an ephemeral one; that exact redirect URI must be registered too.
#
# Setup:
#   1. Create an app at https://www.dropbox.com/developers/apps
#   2. API: "Scoped access". Access type: "Full Dropbox"
#   3. Permissions tab: enable "files.metadata.read" and "files.content.read" (read-only)
#   4. Settings tab -> OAuth 2 -> Redirect URIs, add the exact callback page URL(s)
#      (not just the bare origin):
#        - http://localhost:5173/dropbox-callback.html for dev
#        - https://kagibi.cloud/dropbox-callback.html for prod
#        - http://localhost:58273 (fixed port used by the desktop app's loopback callback)
#   5. No client secret is created or needed (public client + PKCE for both platforms)
#
# DROPBOX_APP_KEY=your-dropbox-app-key
